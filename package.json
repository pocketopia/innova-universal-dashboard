{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3001 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist-tizen",
    "lint": "tsc --noEmit",
    "build:tv:mvn": "VITE_STANDALONE_APP=mvn vite build",
    "build:tv:kreation": "VITE_STANDALONE_APP=kreation vite build",
    "build:tv:archaven": "VITE_STANDALONE_APP=archaven vite build",
    "build:tv:hektic": "VITE_STANDALONE_APP=hektic vite build",
    "build:tv:streamshare": "VITE_STANDALONE_APP=streamshare vite build",
    "build:tizen:mvn": "VITE_STANDALONE_APP=mvn vite build --outDir dist-tizen/mvn",
    "build:tizen:kreation": "VITE_STANDALONE_APP=kreation vite build --outDir dist-tizen/kreation",
    "build:tizen:archaven": "VITE_STANDALONE_APP=archaven vite build --outDir dist-tizen/archaven",
    "build:tizen:hektic": "VITE_STANDALONE_APP=hektic vite build --outDir dist-tizen/hektic",
    "build:tizen:streamshare": "VITE_STANDALONE_APP=streamshare vite build --outDir dist-tizen/streamshare",
    "build:roku:mvn": "mkdir -p dist-roku && cd tv-builds/roku/mvn && zip -r ../../../dist-roku/mvn.zip .",
    "build:roku:kreation": "mkdir -p dist-roku && cd tv-builds/roku/kreation && zip -r ../../../dist-roku/kreation.zip .",
    "build:roku:archaven": "mkdir -p dist-roku && cd tv-builds/roku/archaven && zip -r ../../../dist-roku/archaven.zip .",
    "build:roku:hektic": "mkdir -p dist-roku && cd tv-builds/roku/hektic && zip -r ../../../dist-roku/hektic.zip .",
    "build:roku:streamshare": "mkdir -p dist-roku && cd tv-builds/roku/streamshare && zip -r ../../../dist-roku/streamshare.zip ."
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-router-dom": "^5.3.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
